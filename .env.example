# MARINEX runtime mode
USE_DEMO_DATA=false

# Real-time AIS (https://aisstream.io)
AISSTREAM_API_KEY=

# Optional. Public Open-Meteo Marine access needs no key. Paid customers can
# set this key; MARINEX then selects the customer-marine-api endpoint.
OPEN_METEO_API_KEY=

# Global Fishing Watch
GFW_API_TOKEN=

# Copernicus Marine / Data Space credentials
COPERNICUS_USER=
COPERNICUS_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional provider endpoint overrides
NOAA_ERDDAP_URL=https://coastwatch.pfeg.noaa.gov/erddap
NOAA_NOMADS_URL=https://nomads.ncep.noaa.gov

# API server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
